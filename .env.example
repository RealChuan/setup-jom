# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens should not be converted to underscores! Keep the keys sorted, the
# super-linter runs dotenv-linter with the `UnorderedKey` rule enabled.
INPUT_ADD-TO-PATH=true
INPUT_CLEAN=true
INPUT_INSTALL-DIR=C:\jom
INPUT_JOM-VERSION=latest
INPUT_VERIFY-CHECKSUM=true

# The action skips the installation when the runner is not Windows, so testing
# the real installation locally requires a Windows machine.
# WINDOWS_LOCAL_TEST=true
